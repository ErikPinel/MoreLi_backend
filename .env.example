PORT=3000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Project Settings > API
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Account Settings > Access Tokens; required only for Management API provisioning.
SUPABASE_PROJECT_REF=replace-me
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
